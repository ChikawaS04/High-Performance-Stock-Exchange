<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.david</groupId>
    <artifactId>OrderBookDemo</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Main artifact compiled to Java 21 bytecode (class-file 65): loads on the
             everyday JDK 25 runtime and on the JDK 21 benchmark fork alike. Benchmarks
             are run under JDK 21 via JAVA_HOME (see jmh-maven-plugin below), so no
             toolchains machinery is needed. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <netty.version>4.2.16.Final</netty.version>
        <jackson.version>2.18.2</jackson.version>
        <jmh.version>1.37</jmh.version>
        <!-- Phase 15 journal. Aeron 1.53.3 and SBE 1.40.2 both depend on Agrona 2.6.1,
             so Agrona arrives transitively and is not pinned here. -->
        <aeron.version>1.53.3</aeron.version>
        <sbe.version>1.40.2</sbe.version>
        <sbe.output.dir>${project.build.directory}/generated-sources/sbe</sbe.output.dir>
        <!-- Phase 15 database (P15-9). -->
        <postgresql.version>42.7.14</postgresql.version>
        <flyway.version>13.10.3</flyway.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- JMH: benchmark-only, test scope. jmh-core is the harness API; the
             annotation processor generates benchmark metadata during test-compile,
             so benchmarks compile/run from the IDE and via `mvn jmh:benchmark` alike. -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.18</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Phase 15 journal: embedded media driver, IPC client and Archive (SRS §3.9). -->
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-client</artifactId>
            <version>${aeron.version}</version>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-driver</artifactId>
            <version>${aeron.version}</version>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-archive</artifactId>
            <version>${aeron.version}</version>
        </dependency>

        <!-- Phase 15 database: plain JDBC and versioned migrations (SRS §3.13). Off the critical path. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- SBE code generation (Phase 15). SbeTool runs at generate-sources from the
                 schema in src/main/resources/sbe and writes flyweight codecs into package
                 `codec` under target/generated-sources/sbe. Generated code is never committed;
                 a clean checkout regenerates it on every build. sbe-tool is a plugin
                 dependency only: the generated code needs nothing but Agrona at runtime. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>sbe-generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>uk.co.real_logic.sbe.SbeTool</mainClass>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <blockSystemExit>true</blockSystemExit>
                            <systemProperties>
                                <systemProperty>
                                    <key>sbe.output.dir</key>
                                    <value>${sbe.output.dir}</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>sbe.target.language</key>
                                    <value>Java</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>sbe.validation.stop.on.error</key>
                                    <value>true</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>sbe.validation.warnings.fatal</key>
                                    <value>true</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>sbe.generate.ir</key>
                                    <value>false</value>
                                </systemProperty>
                            </systemProperties>
                            <arguments>
                                <argument>${project.basedir}/src/main/resources/sbe/exchange-schema.xml</argument>
                                <!-- P15-5: engine snapshots, schema id 2, package codec.snapshot. -->
                                <argument>${project.basedir}/src/main/resources/sbe/snapshot-schema.xml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Runs the exchange with the Agrona flag (P15-4), from app/backend:
                         mvn -q compile exec:exec@exchange
                         on the JDK Maven runs on (JAVA_HOME), not whichever java is on PATH.
                         Settings come from environment variables (ExchangeConfig, D9). -->
                    <execution>
                        <id>exchange</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>--add-exports</argument>
                                <argument>java.base/jdk.internal.misc=ALL-UNNAMED</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>Main</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Applies pending migrations and exits (P15-9), the pre-deploy command, from app/backend:
                         mvn -q compile exec:exec@migrate
                         Reads DB_URL, DB_USER and DB_PASSWORD. Touches no Agrona, so it needs no flag. -->
                    <execution>
                        <id>migrate</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>db.MigrateCommand</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>uk.co.real-logic</groupId>
                        <artifactId>sbe-tool</artifactId>
                        <version>${sbe.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>add-sbe-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${sbe.output.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Agrona 2.x (UnsafeApi, behind UnsafeBuffer and every SBE flyweight) uses
                         jdk.internal.misc.Unsafe, which java.base does not export: without this,
                         BufferUtil fails to initialise with IllegalAccessError. Valid on JDK 21
                         and 25. Any JVM that runs the exchange needs the same flag. -->
                    <argLine>--add-exports java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!-- Runs JMH benchmarks from src/test/java. Explicit invocation only
                 (`mvn jmh:benchmark`) — benchmarks are not part of the normal build.
                 Run that command with JAVA_HOME pointed at JDK 21 so the whole Maven
                 process, and every JMH-forked child JVM, measures on 21.
                 To enable the GC profiler: mvn jmh:benchmark -Djmh.prof=gc -->
            <plugin>
                <groupId>pw.krejci</groupId>
                <artifactId>jmh-maven-plugin</artifactId>
                <version>0.2.2</version>
            </plugin>
        </plugins>
    </build>

</project>