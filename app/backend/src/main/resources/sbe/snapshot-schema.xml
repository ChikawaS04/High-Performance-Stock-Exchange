<?xml version="1.0" encoding="UTF-8"?>
<!--
    Engine snapshot encoding (SRS §3.10, D14). A separate schema from the journal's: the journal
    is permanent and changes only additively, while snapshots are disposable (always rebuildable
    from the journal) and will grow (session state at P15-8). Separate ids and versions keep a
    snapshot change from ever touching the journal decoder, and keep one kind of file from being
    read as the other.

    Little-endian, same units as the journal: prices in long units of $0.0001, timestamps in
    epoch nanoseconds. Field order: int64 first, then int32, then uint8 enums.

    A snapshot file is one EngineSnapshot message, then exactly orderCount RestingOrder messages,
    then a 12-byte trailer written by the snapshot store (body length and CRC32C), outside this
    schema. Orders are separate messages rather than a repeating group because SBE group counts
    are 16-bit at most, and a book can hold more resting orders than that.

    The RestingOrder messages list every resting order in restore order: bids best-first, level by
    level, each level in queue order; then asks the same way; then the bid peg pool and the ask
    peg pool, each in FIFO order. Restore appends entries in this order, so queue and pool order
    come back exactly.

    Version 0. Session state (P15-8) is added as root-block fields with sinceVersion="1"; a
    version 0 snapshot then decodes with those fields at their null values.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="codec.snapshot"
                   id="2"
                   version="0"
                   semanticVersion="15.5"
                   description="High Performance Stock Exchange engine snapshot"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>

        <enum name="LocationCode" encodingType="uint8">
            <validValue name="BID">0</validValue>
            <validValue name="ASK">1</validValue>
            <validValue name="PEG_BID">2</validValue>
            <validValue name="PEG_ASK">3</validValue>
        </enum>
        <enum name="SideCode" encodingType="uint8">
            <validValue name="BUY">0</validValue>
            <validValue name="SELL">1</validValue>
        </enum>
        <enum name="StatusCode" encodingType="uint8">
            <validValue name="OPEN">0</validValue>
            <validValue name="PARTIALLY_FILLED">1</validValue>
            <validValue name="FILLED">2</validValue>
            <validValue name="CANCELLED">3</validValue>
            <validValue name="EXPIRED">4</validValue>
        </enum>
        <enum name="TimeInForceCode" encodingType="uint8">
            <validValue name="GTC">0</validValue>
            <validValue name="IOC">1</validValue>
            <validValue name="FOK">2</validValue>
        </enum>
        <enum name="OrdTypeCode" encodingType="uint8">
            <validValue name="LIMIT">0</validValue>
            <validValue name="PEG_MID">1</validValue>
        </enum>
    </types>

    <sbe:message name="EngineSnapshot" id="1" description="Complete engine state after one applied command">
        <field name="inboundSeq" id="1" type="int64"/>
        <field name="inboundPosition" id="2" type="int64"/>
        <field name="inboundRecordingId" id="3" type="int64"/>
        <field name="outboundLastSeq" id="4" type="int64"/>
        <field name="nextTradeId" id="5" type="int64"/>
        <field name="lastCommandTimestamp" id="6" type="int64"/>
        <field name="orderCount" id="7" type="int64"/>
    </sbe:message>

    <sbe:message name="RestingOrder" id="2" description="One resting order, every Order field">
        <field name="orderId" id="1" type="int64"/>
        <field name="timeStamp" id="2" type="int64"/>
        <field name="participantId" id="3" type="int64"/>
        <field name="price" id="4" type="int64"/>
        <field name="quantity" id="5" type="int32"/>
        <field name="peak" id="6" type="int32"/>
        <field name="visibleQty" id="7" type="int32"/>
        <field name="location" id="8" type="LocationCode"/>
        <field name="side" id="9" type="SideCode"/>
        <field name="status" id="10" type="StatusCode"/>
        <field name="tif" id="11" type="TimeInForceCode"/>
        <field name="ordType" id="12" type="OrdTypeCode"/>
    </sbe:message>
</sbe:messageSchema>
