VITE_WS_URL=ws://localhost:8080/ws
VITE_IGNITION_SYMBOL=ASML
# Alpaca credentials are read by vite.config.ts (dev-server proxy) from .env.local
# and are intentionally NOT VITE_-prefixed, so they never enter the client bundle.
# Set them in .env.local (gitignored):
#   ALPACA_KEY_ID=...
#   ALPACA_SECRET_KEY=...
