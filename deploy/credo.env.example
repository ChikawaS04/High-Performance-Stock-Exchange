# credo.env: every setting of the Compose stack (Phase 16, D6). Copy to /opt/credo/credo.env,
# owned by david, mode 600, and fill in the secrets. Never commit the filled-in file.
#
#   docker compose --env-file credo.env up -d
#
# A blank value means "unset": the venue and the bots then use their defaults, shown in the
# comments. Bot values below are the production ones; the development default follows "dev:".

# --- image and host ---------------------------------------------------------------------------
# Image tag: the git short sha being deployed (set by deploy.sh).
IMAGE_TAG=
# Host directory bind-mounted at /data in the exchange (owned by uid 10001).
CREDO_DATA_DIR=/srv/credo/data
# Compose network; the bots' static address is for WS_EXEMPT_ADDRESSES (P16-9).
CREDO_SUBNET=172.30.0.0/24
BOTS_IPV4=172.30.0.10
EXCHANGE_MEM_LIMIT=8g
POSTGRES_MEM_LIMIT=2g
BOTS_MEM_LIMIT=512m
EXCHANGE_JAVA_OPTS=-Xms3g -Xmx3g -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError
MIGRATE_JAVA_OPTS=-Xmx256m
BOTS_JAVA_OPTS=-Xms128m -Xmx256m -XX:+ExitOnOutOfMemoryError

# --- PostgreSQL --------------------------------------------------------------------------------
# Superuser password of the postgres container (used only by the init script and backups).
POSTGRES_PASSWORD=
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=30

# --- venue database (role exchange, database exchange; postgres-init creates both) -------------
DB_URL=jdbc:postgresql://postgres:5432/exchange
DB_USER=exchange
# Also the exchange role's password, set by postgres-init on an EMPTY volume only.
DB_PASSWORD=

# --- venue (ExchangeConfig). EXCHANGE_PORT, EXCHANGE_DATA_DIR, AERON_DIR and DB_MIGRATE_ON_START
# are fixed by compose.yaml (8080, /data, /dev/shm/aeron-exchange, false). ------------------------
# Snapshot every N inbound commands (default 10000).
SNAPSHOT_INTERVAL=
# busy-spin | yielding | sleeping | backoff (default backoff).
ENGINE_IDLE_STRATEGY=
# Archive and media driver threads: busy-spin | yielding | sleeping | backoff (default backoff).
JOURNAL_IDLE_STRATEGY=
# Disruptor rings: blocking | yielding | busy-spin (default blocking).
RING_WAIT_STRATEGY=
# SHARED | DEDICATED (default SHARED).
JOURNAL_ARCHIVE_THREADING=
# Bytes, power of two (default 16777216).
JOURNAL_SEGMENT_LENGTH=
# Bytes, power of two (default 262144).
JOURNAL_TERM_LENGTH=
# Journal retention (P16-7): closed business days kept besides the current day, 0 to 366
# (default 2). A nightly database backup can resume only with 1 or more.
JOURNAL_RETENTION_DAYS=
# false freezes the journal: nothing is purged (default true).
JOURNAL_RETENTION_ENABLED=
# The Archive's low storage threshold (P16-8), bytes (default 1073741824, 1 GiB). Checked only when a
# recording starts or extends, so it is a startup floor: at or below it the venue exits 2 before writing.
# At least one segment, and below DISK_STOP_FREE_BYTES.
JOURNAL_LOW_STORAGE_BYTES=
# Database retention (P16-8): COMPLETE business dates whose orders, executions and audit rows are kept,
# 0 to 3660 (default 14). Candles, clearing results, daily summaries, balances and positions are kept.
DB_RETENTION_DAYS=
# false keeps every detail row (default true).
DB_RETENTION_ENABLED=
# Rows deleted per transaction, 100 to 100000 (default 5000).
DB_RETENTION_BATCH_ROWS=
# VACUUM (ANALYZE), never FULL, each table a pass deleted from (default true).
DB_RETENTION_VACUUM=
# Disk guard (P16-8), bytes free on the filesystem holding the data directory (the server's root disk,
# shared with Docker and so with PostgreSQL). WARN at most hourly below this (default 16106127360, 15 GiB).
DISK_WARN_FREE_BYTES=
# NEW orders refused below this, cancels accepted; 0 turns the stop off (default 5368709120, 5 GiB).
DISK_STOP_FREE_BYTES=
# NEW accepted again at the stop value plus this (default 1073741824, 1 GiB).
DISK_STOP_HYSTERESIS_BYTES=
# Instrument (defaults ASML, 100, 1, 10000, America/New_York).
SESSION_SYMBOL=
SESSION_TICK_SIZE=
SESSION_LOT_SIZE=
SESSION_PRICE_SCALE=
SESSION_TIME_ZONE=
# Open the session automatically on each business day (default true).
SESSION_AUTO_OPEN=

# --- Alpaca (backend only; never in the frontend or the bots) ---------------------------------
# Both or neither. With neither, /market/ignition answers 404.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Default https://data.alpaca.markets.
ALPACA_DATA_URL=

# --- bots (participant.BotSettings) ------------------------------------------------------------
# The venue as the bots reach it on the Compose network. dev: http://localhost:8080
BOTS_VENUE_URL=http://exchange:8080
# dev: ASML
BOTS_SYMBOL=ASML
# Fallback only when the venue has no Alpaca keys (/market/ignition answers 404); dollars, on the
# cent tick; must be near the instrument's real price. Blank: with no keys the bots exit 2.
BOTS_OPEN_PX=
# Any of maker,trend,revert,noise,inst. dev: all five
BOTS_ENABLED=maker,trend,revert,noise,inst
# dev: a new seed each start
BOTS_SEED=
# Scales every interval. dev: 1.0
BOTS_SPEED=1.0
# Strategy tick in ms. dev: 250
BOTS_TICK_MS=250
# Price-path CSV path, or none. dev: run-output/price_path_<time>.csv
BOTS_CSV=none
# One STATUS line per bot every N ms (0 = off). dev: 60000
BOTS_STATUS_INTERVAL_MS=60000
# Risk band around the open, percent. dev: 20
BOTS_BAND_PERCENT=20
# Risk gate: largest single order, and most GTC orders working per bot. dev: 30000, 50
BOTS_MAX_ORDER_QTY=6000
BOTS_MAX_OPEN_ORDERS=30
# Maker ladder levels a side (100, 200, ... capped at 1000). dev: 20
BOTS_MAKER_LEVELS=10
# dev: 2, 2
BOTS_MAKER_HALF_SPREAD_TICKS=2
BOTS_MAKER_REQUOTE_MOVE_TICKS=2
# Refresh at least this often. dev: 10000
BOTS_MAKER_REQUOTE_INTERVAL_MS=10000
# At most one full requote per gap. dev: 0
BOTS_MAKER_MIN_REQUOTE_GAP_MS=1000
# Inventory limit; blank = a ladder side + 3000 (8500 for 10 levels). dev: 18500
BOTS_MAKER_MAX_POSITION=8500
# Skew: one tick per N shares of inventory, at most M ticks. dev: 300, 10
BOTS_MAKER_SKEW_CLIP=300
BOTS_MAKER_MAX_SKEW_TICKS=10
# Pull toward the open: one tick per DIVISOR ticks of distance, at most MAX ticks. dev: 0 (off), 20
BOTS_MAKER_ANCHOR_MAX_PULL_TICKS=5
BOTS_MAKER_ANCHOR_PULL_DIVISOR=20
# Trend follower. dev: 50, 1500, 3000, 1500
BOTS_TREND_QTY=50
BOTS_TREND_MIN_INTERVAL_MS=3000
BOTS_TREND_MAX_INTERVAL_MS=6000
BOTS_TREND_MAX_POSITION=1500
# Mean reversion. dev: 4000, 2000
BOTS_REVERT_REQUOTE_INTERVAL_MS=8000
BOTS_REVERT_MAX_POSITION=2000
# Noise trader. dev: 1200, 1000
BOTS_NOISE_MEAN_ARRIVAL_MS=1200
BOTS_NOISE_MAX_POSITION=1000
# Institutional parents and limit. dev: 10000, 30000, 40000
BOTS_INST_MIN_PARENT=2000
BOTS_INST_MAX_PARENT=6000
BOTS_INST_MAX_POSITION=10000
